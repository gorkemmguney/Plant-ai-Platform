# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plant_ai_db
DB_USERNAME=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

# ─── Firebase ────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# İndirdiğin JSON dosyasını backend/ klasörüne koy ve aşağıya adını yaz
FIREBASE_CREDENTIALS_PATH=./your-firebase-adminsdk-xxxx.json
FIREBASE_PROJECT_ID=plant-ai-platform-f5234

# ─── Gemini AI ───────────────────────────────────────────────
# https://aistudio.google.com/app/apikey adresinden ücretsiz alabilirsin
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ─── App ─────────────────────────────────────────────────────
ENV=development
CORS_ORIGINS=*
DEFAULT_ROLE=customer
